# Copier ce fichier en `.env.local` et renseigner les identifiants une fois
# les comptes Google Analytics / Meta Business créés. Tant qu'ils sont vides,
# aucun script de tracking n'est chargé (même si un visiteur accepte les
# cookies) — le site reste fonctionnel dans les deux cas.

# Google Analytics 4 — format G-XXXXXXXXXX (Admin > Flux de données > ID de mesure)
NEXT_PUBLIC_GA_ID=

# Meta Pixel — identifiant numérique (Gestionnaire d'événements Meta)
NEXT_PUBLIC_META_PIXEL_ID=

# Formulaire de contact (pop-up "Envoyez votre brief") — sans ces deux
# variables, le formulaire reste affiché mais renvoie une erreur à l'envoi.

# Resend — clé API (resend.com > API Keys). Le domaine d'envoi (ex. theotter.fr)
# doit être vérifié côté Resend pour que le "from" ci-dessous fonctionne.
RESEND_API_KEY=

# Adresse qui reçoit les briefs envoyés depuis le site
CONTACT_TO_EMAIL=contact@theotter.fr
